[Unit]
Description=up HTTP uptime monitor
Documentation=https://github.com/heohlee/up
Wants=network-online.target
After=network-online.target

[Service]
# Ping monitors send ICMP through unprivileged ICMP sockets, which the kernel
# allows to the groups in net.ipv4.ping_group_range. systemd sets it to every
# group by default, so this unit needs no capability. If `up serve` logs
# "cannot send pings", widen the range (sysctl net.ipv4.ping_group_range="0
# 2147483647") or, as a last resort, run `systemctl edit up` and add:
#   [Service]
#   AmbientCapabilities=CAP_NET_RAW
Type=simple
User=up
Group=up
ExecStart=/usr/local/bin/up serve --db /var/lib/up/up.db
StateDirectory=up
StateDirectoryMode=2770
UMask=0007
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
